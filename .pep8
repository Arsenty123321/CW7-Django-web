[flake8]
exclude =
    */migrations/
    settings/
    .git/
    __pycache__/
    .venv/
max-line-length = 120

[pep8]
exclude =
    */migrations/
    settings/
    .git/
    __pycache__/
    .venv/
max-line-length = 120

[pycodestyle]
exclude =
    */migrations/
    settings/
    .git/
    __pycache__/
    .venv/
max-line-length = 120